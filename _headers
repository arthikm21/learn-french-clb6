# Cloudflare Pages cache rules
/audio/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/audio/manifest.json
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/data/*
  Cache-Control: public, max-age=300, stale-while-revalidate=86400

/modules/*
  Cache-Control: public, max-age=300, stale-while-revalidate=86400

/*.js
  Cache-Control: public, max-age=300, stale-while-revalidate=86400

# Service worker: must revalidate on every check so a new release's worker
# (and its fresh shell cache) activates without waiting out a TTL. The `!`
# detaches the /*.js rule's value so only no-cache is sent.
/sw.js
  ! Cache-Control
  Cache-Control: no-cache

/*.css
  Cache-Control: public, max-age=300, stale-while-revalidate=86400

/*.html
  Cache-Control: public, max-age=60, must-revalidate

/og-image.jpg
  Cache-Control: public, max-age=86400

# Exam-kit cover thumbnails — change only when a pack is redesigned
/kit/*
  Cache-Control: public, max-age=604800

/favicon.svg
  Cache-Control: public, max-age=604800
/favicon.ico
  Cache-Control: public, max-age=604800
/*.png
  Cache-Control: public, max-age=604800
/site.webmanifest
  Cache-Control: public, max-age=86400

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), geolocation=(), payment=(), usb=(), microphone=(self)
  Content-Security-Policy: frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'
